<script>
/* the groups table: a new empty row whenever the last one is filled in, and "Add a row" */
(function () {
  var body = document.getElementById('oidc-grp-rows'), add = document.getElementById('oidc-grp-add');
  if (!body || !add) { return; }
  var next = body.rows.length;
  function more() {
    var last = body.rows[body.rows.length - 1], row = last.cloneNode(true);
    row.querySelectorAll('input, select').forEach(function (el) {
      el.name = el.name.replace(/\[\d+\]$/, '[' + next + ']');
      if (el.tagName === 'SELECT') { el.selectedIndex = 0; } else { el.value = ''; }
    });
    next++;
    body.appendChild(row);
    return row;
  }
  add.hidden = false;
  add.addEventListener('click', function () { var r = more(); r.querySelector('input').focus(); });
  body.addEventListener('input', function (e) {
    var last = body.rows[body.rows.length - 1];
    if (last.contains(e.target) && last.querySelector('input').value.trim() !== '') { more(); }
  });
})();
function oidcDirty(i) {
  i.classList.toggle('oidc-dirty', i.value !== i.defaultValue);
  var any = document.querySelector('.oidc-table input.oidc-dirty, .oidc-table input[name^=unlink]:checked');
  var bar = document.querySelector('.oidc-unsaved');
  if (bar) { bar.classList.toggle('on', !!any); }
}
document.querySelectorAll('.oidc-table input[type=text]').forEach(function (i) {
  i.addEventListener('input', function () { oidcDirty(i); });
});
document.querySelectorAll('.oidc-table input[name^=unlink]').forEach(function (c) {
  c.addEventListener('change', function () { oidcDirty(c); });
});
document.querySelectorAll('.oidc-use').forEach(function (b) {
  b.addEventListener('click', function () {
    var i = b.parentNode.querySelector('input[type=text]');
    if (i) { i.value = b.getAttribute('data-value'); i.focus(); oidcDirty(i); }
  });
});
</script>
